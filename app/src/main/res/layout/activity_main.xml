<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zoom Auto Join"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/classTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Class name (e.g. Math 101)"/>

    <EditText
        android:id="@+id/zoomLinkInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste Zoom link (https://zoom.us/j/...?pwd=...)"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/pickDateButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Pick Date"/>

        <Button
            android:id="@+id/pickTimeButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Pick Time"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/repeatWeeklyCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat every week"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Schedule Auto-Join"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="One-time setup (recommended for reliability):"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/exactAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow Exact Alarms"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/batteryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disable Battery Optimization for this app"
        android:layout_marginTop="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upcoming classes:"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scheduleList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>

</LinearLayout>
</ScrollView>
